# Copy to ".env.cloud" and fill in. Passed to LiveKit Cloud with --secrets-file.
# The file name starts with ".env." so LiveKit leaves it out of the image.
# Do NOT add LIVEKIT_URL / LIVEKIT_API_KEY / LIVEKIT_API_SECRET: LiveKit injects them.

GEMINI_API_KEY=
DEEPGRAM_API_KEY=

LLM_PROVIDER=gemini
STT_PROVIDER=deepgram
TTS_PROVIDER=deepgram
CLINIC_TIMEZONE=Asia/Karachi

# Phase 1 (latency test): mock calendar + the container's temporary database.
# Phase 2 (real bookings): set this to false, add the GOOGLE_* values and DATABASE_URL.
GOOGLE_CALENDAR_SANDBOX=true
