# =====================================================================
# Clinical Voice Agent - Environment Configuration
# =====================================================================

# Server & Environment
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
LOG_LEVEL=INFO
SECRET_KEY=change-this-in-production-to-a-secure-random-key

# Database Connection (PostgreSQL with SQLite fallback)
# Production / Staging: postgresql+psycopg2://user:password@localhost:5432/clinical_agent
# Development / Local fallback: sqlite:///./clinical_agent.db
DATABASE_URL=sqlite:///./clinical_agent.db
POSTGRES_PASSWORD=replace-with-a-long-random-password

# LiveKit Cloud or Local Server
# Free tier LiveKit Cloud: https://cloud.livekit.io
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_AGENT_NAME=clinical-voice-agent
LIVE_TEST_AGENT_NAME=clinical-voice-agent-test

# LLM Providers (Multi-Provider Support)
# Supported: "groq", "openai", "gemini"
LLM_PROVIDER=gemini
GROQ_API_KEY=gsk_your_free_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=sk-your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# Speech-to-Text (STT) Provider
# Supported: "deepgram", "openai", "groq"
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=your_deepgram_api_key

# Text-to-Speech (TTS) Provider
# Supported: "elevenlabs", "openai", "edge"
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM # Rachel (Gentle, Professional Receptionist)
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# Google Calendar Configuration
# Keep sandbox enabled for development/evaluation; set false only after configuring live OAuth credentials.
GOOGLE_CALENDAR_SANDBOX=true
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REFRESH_TOKEN=your_google_oauth_refresh_token
GOOGLE_CALENDAR_ID=primary
# Live call tests use this database only; the test worker runs with the mock calendar.
LIVE_TEST_DATABASE_URL=sqlite:///./clinical_live_test.db

# Clinic Operational Defaults
CLINIC_NAME="Serenity Medical Clinic"
CLINIC_TIMEZONE=America/New_York
CLINIC_OPENING_TIME=09:00
CLINIC_CLOSING_TIME=17:00
DEFAULT_APPOINTMENT_DURATION_MINUTES=30
BUFFER_TIME_MINUTES=10
